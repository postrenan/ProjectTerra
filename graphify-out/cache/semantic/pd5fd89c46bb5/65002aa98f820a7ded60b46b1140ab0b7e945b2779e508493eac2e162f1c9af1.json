{"nodes": [{"id": "docs_architecture_terrain_document", "label": "ARCHITECTURE_1_TO_1_SCALE_TERRAIN.md", "file_type": "document", "source_file": "docs/ARCHITECTURE_1_TO_1_SCALE_TERRAIN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_architecture_scale_1_to_1_challenge", "label": "Planetary 1:1 Scale Terrain Challenge", "file_type": "rationale", "source_file": "docs/ARCHITECTURE_1_TO_1_SCALE_TERRAIN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Storing entire Earth surface (510 million km2) at 1m LIDAR resolution requires 1 Petabyte (510T points * 2 bytes) and 250 GB even at 30m resolution, making static pre-download completely infeasible."}, {"id": "docs_architecture_hybrid_streaming", "label": "Three-Tier Hybrid Streaming Architecture", "file_type": "concept", "source_file": "docs/ARCHITECTURE_1_TO_1_SCALE_TERRAIN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adopts Microsoft Flight Simulator 2024 and Google Earth model: Tile-on-Demand streaming, persistent local binary cache (O(1)), GPU procedural micro-scale amplification, and 100% offline resilient fractal generation."}, {"id": "docs_architecture_aws_terrarium_tiles", "label": "AWS Open Data Terrain Tiles (Terrarium DEM)", "file_type": "concept", "source_file": "docs/ARCHITECTURE_1_TO_1_SCALE_TERRAIN.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Public, free Web Mercator DEM tiles hosted on AWS S3 where RGB encodes elevation: (R*256 + G + B/256) - 32768, spanning -32768m to +32767m with submetric 1/256m precision without API keys."}, {"id": "docs_architecture_copernicus_dem", "label": "Copernicus DEM GLO-30", "file_type": "concept", "source_file": "docs/ARCHITECTURE_1_TO_1_SCALE_TERRAIN.md", "source_location": null,